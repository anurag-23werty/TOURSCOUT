# Copy to .env and fill in. Never commit .env.

# Qloo (hackathon keys only work on this base URL)
QLOO_API_KEY=
QLOO_BASE_URL=https://hackathon.api.qloo.com

# Google AI Studio — primary LLM (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MAIN_MODEL=gemini-flash-latest
GEMINI_LITE_MODEL=gemini-flash-lite-latest

# Groq — fallback LLM, text only (https://console.groq.com/keys)
GROQ_API_KEY=
GROQ_FALLBACK_MODEL=openai/gpt-oss-120b

# LLM routing (apps/api/tourscout_api/core/config.py)
# LLM_PRIMARY=gemini            # or groq
# LLM_PRIMARY_TIMEOUT_S=12      # fast-fail per Gemini model
# LLM_COOLDOWN_S=120            # circuit breaker after a failure

# Storage
DATABASE_URL=                   # postgresql://… (Neon) → agent checkpoints in Postgres; empty → SQLite in ~/.cache/tourscout
TOURSCOUT_CACHE_URL=            # Qloo response cache: postgresql://… or sqlite:///…; empty → ~/.cache/tourscout/qloo.sqlite

# API (apps/api/tourscout_api/api/settings.py)
WEB_ORIGINS=http://localhost:5173   # comma-separated; add the Vercel URL in production
TRUST_PROXY=false                   # true behind Railway/Fly so rate limits use X-Forwarded-For
# LIMIT_PLANS_PER_IP_HOUR=6
# LIMIT_PLANS_PER_DAY=150
# LIMIT_LLM_ACTIONS_PER_IP_HOUR=30
# LIMIT_UPLOADS_PER_IP_HOUR=10
# LIMIT_CONCURRENT_PLANS=3

# Observability (Phase 7)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Optional external data (Phase 2+)
MUSICBRAINZ_USER_AGENT=TourScout/0.1 (https://github.com/anurag-23werty/TOURSCOUT)
SETLISTFM_API_KEY=
